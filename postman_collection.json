{
  "info": {
    "name": "Badminton Court Booking System - FR-03, FR-07, FR-08",
    "description": "Postman Collection for Testing FR-03 (Logout), FR-07 (Booking History), and FR-08 (Booking Approval)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"access_token\", jsonData.data.accessToken);",
                  "    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
                  "    pm.environment.set(\"user_id\", jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"customer1\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login with customer credentials to get JWT token"
          },
          "response": []
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"admin_token\", jsonData.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin1\",\n    \"password\": \"adminpass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login with admin credentials to get JWT token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "FR-03: Logout & Token Revocation",
      "item": [
        {
          "name": "Logout (Revoke JWT Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Logout and add JWT token to blacklist. Token will no longer be valid after this."
          },
          "response": []
        },
        {
          "name": "Try to Use Blacklisted Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/bookings/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "bookings",
                "history"
              ]
            },
            "description": "This request should fail with 403 Forbidden if token was successfully blacklisted"
          },
          "response": []
        },
        {
          "name": "Expected Response Before Logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/bookings/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "bookings",
                "history"
              ]
            },
            "description": "This works fine before logout"
          },
          "response": []
        }
      ],
      "description": "Test FR-03 Logout and Token Blacklist functionality"
    },
    {
      "name": "FR-07: Booking History",
      "item": [
        {
          "name": "Get Booking History - Success",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/bookings/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "bookings",
                "history"
              ]
            },
            "description": "Get all bookings for the current customer, sorted by creation date (newest first)"
          },
          "response": []
        },
        {
          "name": "Get Booking History - Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/bookings/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "bookings",
                "history"
              ]
            },
            "description": "This should fail with 401 Unauthorized"
          },
          "response": []
        },
        {
          "name": "Get Booking History - With Invalid Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid.token.here",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/bookings/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "bookings",
                "history"
              ]
            },
            "description": "This should fail with 401 Unauthorized"
          },
          "response": []
        }
      ],
      "description": "Test FR-07 View Booking History for CUSTOMER role"
    },
    {
      "name": "FR-08: Booking Approval",
      "item": [
        {
          "name": "Approve Booking - CONFIRMED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/1/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "1",
                "approval"
              ]
            },
            "description": "Approve a pending booking by setting status to CONFIRMED. Only ADMIN or MANAGER can do this."
          },
          "response": []
        },
        {
          "name": "Reject Booking - REJECTED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"REJECTED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/2/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "2",
                "approval"
              ]
            },
            "description": "Reject a pending booking by setting status to REJECTED. Only ADMIN or MANAGER can do this."
          },
          "response": []
        },
        {
          "name": "Try to Approve Non-Existent Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/9999/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "9999",
                "approval"
              ]
            },
            "description": "Should return 404 Not Found if booking does not exist"
          },
          "response": []
        },
        {
          "name": "Try to Approve Already Confirmed Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/3/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "3",
                "approval"
              ]
            },
            "description": "Should return 409 Conflict if booking is not in PENDING status"
          },
          "response": []
        },
        {
          "name": "Try to Set Invalid Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"CANCELLED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/4/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "4",
                "approval"
              ]
            },
            "description": "Should return 400 Bad Request - only CONFIRMED or REJECTED are allowed"
          },
          "response": []
        },
        {
          "name": "Try Approve as Customer (No Permission)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/5/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "5",
                "approval"
              ]
            },
            "description": "Should return 403 Forbidden - customer role is not authorized"
          },
          "response": []
        },
        {
          "name": "Try Approve Without Token",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/6/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "6",
                "approval"
              ]
            },
            "description": "Should return 401 Unauthorized"
          },
          "response": []
        }
      ],
      "description": "Test FR-08 Booking Approval functionality for ADMIN or MANAGER role"
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
